# Mistral API (required for live extraction / radar / TTS)
MISTRAL_API_KEY=

# Optional: Voxtral TTS voice from Mistral Studio
# Without this, SyncSpace still generates the audio script and shows it in the UI.
VOXTRAL_VOICE_ID=

# Optional: HMAC secret for signing the demo session cookie.
# Falls back to a fixed dev value if unset — fine for the hackathon demo, not for production.
SESSION_SECRET=
