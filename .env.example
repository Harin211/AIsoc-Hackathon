# Mistral API (required for live extraction / radar / TTS)
MISTRAL_API_KEY=

# Optional: Voxtral TTS voice from Mistral Studio
# Without this, SyncSpace still generates the audio script and shows it in the UI.
VOXTRAL_VOICE_ID=

# HMAC secret for signing the session cookie. Required in production —
# generate one with: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection string — Supabase, Neon, or any standard Postgres.
# Required to run the app — accounts and projects are stored here.
# Supabase: Project Settings > Database > Connection string ("Transaction pooler" for serverless deploys).
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=
